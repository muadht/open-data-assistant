# Copy to .env (gitignored) and fill in real values. Read by `uv run api` and
# scripts/llm_provider_spike.py.
OPENAI_API_KEY=

# Optional - the model the chat API uses (any Pydantic AI model string).
# OPEN_DATA_ASSISTANT_MODEL=openai:gpt-5-mini

# Optional - OpenSearch with the catalogue index (defaults: localhost:9200, statcan-products).
# OPENSEARCH_HOST=localhost
# OPENSEARCH_PORT=9200
# OPENSEARCH_INDEX=statcan-products
