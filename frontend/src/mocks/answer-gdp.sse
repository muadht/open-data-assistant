data: {"message_id": "m1", "text": "Using expenditure-based real GDP at market prices in chained (2017) dollars, seasonally adjusted at annual rates, Canada’s real GDP generally moved higher over the period shown: it was $2.467 trillion in Q3 2024 [1] and $2.524 trillion in Q2 2026. The intervening quarterly values were $2.484 trillion in Q4 2024, $2.502 trillion in Q1 2025, $2.496 trillion in Q2 2025, $2.508 trillion in Q3 2025, $2.502 trillion in Q4 2025, and $2.504 trillion in Q1 2026, showing small pullbacks in Q2 and Q4 2025 before rising to the latest value.", "values": [{"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2024-07-01", "value": 2466957000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2026-04-01", "value": 2524127000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2024-10-01", "value": 2484261000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2025-01-01", "value": 2502038000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2025-04-01", "value": 2495975000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2025-07-01", "value": 2507754000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2025-10-01", "value": 2501573000000.0}, {"coordinate": "1.1.1.30.0.0.0.0.0.0", "ref_per": "2026-01-01", "value": 2503604000000.0}], "data_results": [{"product_id": 36100104, "title_en": "Gross domestic product, expenditure-based, Canada, quarterly", "series_title_en": "Canada;Chained (2017) dollars;Seasonally adjusted at annual rates;Gross domestic product at market prices", "members": {"Geography": "Canada", "Prices": "Chained (2017) dollars", "Seasonal adjustment": "Seasonally adjusted at annual rates", "Estimates": "Gross domestic product at market prices"}, "footnotes": [], "coordinate": "1.1.1.30.0.0.0.0.0.0", "vector_id": 62305752, "series": [{"ref_per": "2024-07-01", "value": 2466957000000.0, "uom": "Dollars", "scalar_factor_applied": true, "status": "normal", "symbol": null, "security_level": "public